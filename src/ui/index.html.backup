<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>iOS Simulator</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #f5f5f7;
      color: #1d1d1f;
      overflow: hidden;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Header */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: white;
      border-bottom: 1px solid #e5e5e7;
      flex-shrink: 0;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .header-title {
      font-size: 13px;
      font-weight: 600;
      color: #1d1d1f;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .fps-indicator {
      font-size: 11px;
      color: #86868b;
      font-weight: 500;
    }

    .icon-button {
      width: 28px;
      height: 28px;
      border: none;
      background: transparent;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      color: #1d1d1f;
      transition: background 0.15s;
    }

    .icon-button:hover {
      background: #f5f5f7;
    }

    .icon-button svg {
      width: 16px;
      height: 16px;
    }

    /* Controls */
    .controls {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: white;
      border-bottom: 1px solid #e5e5e7;
      flex-shrink: 0;
    }

    .dropdown {
      position: relative;
    }

    .dropdown-button {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: white;
      border: 1px solid #d2d2d7;
      border-radius: 6px;
      font-size: 12px;
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
    }

    .dropdown-button:hover {
      background: #f5f5f7;
      border-color: #b8b8bd;
    }

    .dropdown-button.active {
      background: #f5f5f7;
      border-color: #0066cc;
    }

    .dropdown-label {
      font-weight: 500;
      color: #1d1d1f;
    }

    .dropdown-value {
      color: #86868b;
      font-size: 11px;
    }

    .dropdown-arrow {
      width: 10px;
      height: 10px;
      color: #86868b;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      background: white;
      border: 1px solid #d2d2d7;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      min-width: 220px;
      max-height: 400px;
      overflow-y: auto;
      z-index: 1000;
      display: none;
    }

    .dropdown-menu.show {
      display: block;
    }

    .dropdown-section {
      padding: 6px 0;
      border-bottom: 1px solid #e5e5e7;
    }

    .dropdown-section:last-child {
      border-bottom: none;
    }

    .dropdown-section-title {
      padding: 6px 12px;
      font-size: 11px;
      font-weight: 600;
      color: #86868b;
      text-transform: uppercase;
    }

    .dropdown-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 12px;
      font-size: 12px;
      cursor: pointer;
      transition: background 0.15s;
    }

    .dropdown-item:hover {
      background: #f5f5f7;
    }

    .dropdown-item.selected {
      background: #e8f0fe;
    }

    .dropdown-item-label {
      flex: 1;
